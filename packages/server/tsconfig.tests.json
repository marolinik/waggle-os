// Typechecks the server tests, which `tsconfig.json` excludes (TD-TEST-11).
// `rootDir` and `composite` are dropped deliberately: this config emits nothing,
// and tests legitimately import fixtures from outside `src/`.
//
// Every server test file is typechecked but one. The first run (2026-09-19)
// surfaced 173 errors across 56 files, held in a baseline exclude list that only
// shrank; 55 were fixed on 2026-09-23 (TD-TEST-11). Do not add a file back to
// `exclude`: fix its types instead.
//
// The one exception is not a test defect. start-trial.test.ts boots the Vite
// dev server with apps/web/vite.config.ts, and this config resolves `vite`
// from the root install while that file's plugins come from apps/web's own
// `vite` copy, whose Plugin types differ. apps/web typechecks its config
// against its own copy (typecheck:web). Remove the entry once the two vite
// installs are one.
//
// `paths` mirrors `vitest.aliases.ts`: several workspace packages declare a
// `dist/` entry in package.json `exports`, which is correct for publishing but
// absent on a fresh checkout — `npm run build:packages` builds only the
// shared -> ... -> server chain, so a test importing e.g.
// `@waggle/hive-mind-shim-core` typechecked locally (stale dist) and failed in
// CI with TS2307. Exact keys, not a `@waggle/*` wildcard: a wildcard would
// rewrite a subpath import like `@waggle/agent/permissions` to
// `packages/agent/permissions/src` and break it.

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": [
      "node",
      "vitest/globals"
    ],
    "baseUrl": "../..",
    "paths": {
      "@waggle/agent": [
        "packages/agent/src/index.ts"
      ],
      "@waggle/cli": [
        "packages/cli/src/index.ts"
      ],
      "@waggle/core": [
        "packages/core/src/index.ts"
      ],
      "@waggle/hive-mind-cli": [
        "packages/hive-mind-cli/src/index.ts"
      ],
      "@waggle/hive-mind-core": [
        "packages/hive-mind-core/src/index.ts"
      ],
      "@waggle/hive-mind-hooks-claude-code": [
        "packages/hive-mind-hooks-claude-code/src/index.ts"
      ],
      "@waggle/hive-mind-hooks-claude-desktop": [
        "packages/hive-mind-hooks-claude-desktop/src/index.ts"
      ],
      "@waggle/hive-mind-hooks-codex": [
        "packages/hive-mind-hooks-codex/src/index.ts"
      ],
      "@waggle/hive-mind-hooks-codex-desktop": [
        "packages/hive-mind-hooks-codex-desktop/src/index.ts"
      ],
      "@waggle/hive-mind-hooks-core": [
        "packages/hive-mind-hooks-core/src/index.ts"
      ],
      "@waggle/hive-mind-hooks-cursor": [
        "packages/hive-mind-hooks-cursor/src/index.ts"
      ],
      "@waggle/hive-mind-hooks-hermes": [
        "packages/hive-mind-hooks-hermes/src/index.ts"
      ],
      "@waggle/hive-mind-hooks-openclaw": [
        "packages/hive-mind-hooks-openclaw/src/index.ts"
      ],
      "@waggle/hive-mind-mcp-server": [
        "packages/hive-mind-mcp-server/src/index.ts"
      ],
      "@waggle/hive-mind-shim-core": [
        "packages/hive-mind-shim-core/src/index.ts"
      ],
      "@waggle/hive-mind-wiki-compiler": [
        "packages/hive-mind-wiki-compiler/src/index.ts"
      ],
      "@waggle/marketplace": [
        "packages/marketplace/src/index.ts"
      ],
      "@waggle/memory-mcp": [
        "packages/memory-mcp/src/index.ts"
      ],
      "@waggle/optimizer": [
        "packages/optimizer/src/index.ts"
      ],
      "@waggle/sdk": [
        "packages/sdk/src/index.ts"
      ],
      "@waggle/server": [
        "packages/server/src/index.ts"
      ],
      "@waggle/shared": [
        "packages/shared/src/index.ts"
      ],
      "@waggle/waggle-dance": [
        "packages/waggle-dance/src/index.ts"
      ],
      "@waggle/weaver": [
        "packages/weaver/src/index.ts"
      ],
      "@waggle/wiki-compiler": [
        "packages/wiki-compiler/src/index.ts"
      ],
      "@waggle/worker": [
        "packages/worker/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "tests/start-trial.test.ts"]
}
