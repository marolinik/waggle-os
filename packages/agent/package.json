{
  "name": "@waggle/agent",
  "version": "0.1.0",
  "description": "Waggle agent — Orchestrator and Tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./external-process-env": {
      "types": "./dist/external-process-env.d.ts",
      "import": "./dist/external-process-env.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "import": "./dist/permissions.js"
    },
    "./tool-filter": {
      "types": "./dist/tool-filter.d.ts",
      "import": "./dist/tool-filter.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build --force && node ../../scripts/stage-agent-pptx-runtime.mjs",
    "prepack": "tsc --build --force && node ../../scripts/stage-agent-pptx-runtime.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@ax-llm/ax": "^24.0.20",
    "@waggle/core": "*",
    "@waggle/marketplace": "*",
    "@waggle/shared": "*",
    "docx": "^9.7.2",
    "exceljs": "^4.4.0",
    "glob": "^13.0.6",
    "jszip": "^3.10.1",
    "pdfmake": "^0.3.11",
    "undici": "^8.11.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/pdfmake": "^0.3.2",
    "pptxgenjs": "file:../../vendor/pptxgenjs"
  }
}
