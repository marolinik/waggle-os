{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["bridge/**/*.ts", "run-waggle-smoke.ts", "run-waggle-smoke-memon.ts", "run-retail-pilot.ts"],
  "exclude": ["node_modules", "upstream", "dist", "tests"]
}
