      "name": "ensemble-tiebreak.ts",
      "filePath": "packages/server/src/benchmarks/judge/ensemble-tiebreak.ts",
      "summary": "Implements the multi-round ensemble tiebreak resolver for the LoCoMo benchmark judge panel, handling plurality voting, fourth-vendor escalation, and fallback to position-weighted scoring when judge models cannot reach a majority verdict.",
      "tags": ["benchmark", "judge", "voting", "tiebreak", "utility"],
      "complexity": "complex",
      "languageNotes": "Uses recursive self-call for the 4-vote re-evaluation path after fourth-vendor escalation; PM_ESCALATION_VERDICT and DEFAULT_FOURTH_VENDOR are exported constants used by the ensemble orchestrator."
    },
    {
      "id": "file:packages/server/src/benchmarks/judge/failure-mode-judge.ts",
      "type": "file",
      "name": "failure-mode-judge.ts",
      "filePath": "packages/server/src/benchmarks/judge/failure-mode-judge.ts",
      "summary": "Core LLM judge infrastructure for the memory benchmark suite: builds structured judge prompts, calls LLM clients with retry logic, parses and validates JSON verdicts, runs multi-model ensemble judging, and computes Fleiss kappa inter-rater agreement statistics.",
      "tags": ["benchmark", "judge", "llm", "ensemble", "statistics"],
      "complexity": "complex",
      "languageNotes": "Defines a 5-class failure-mode taxonomy (F1 ABSTAIN / F2 PARTIAL / F3 INCORRECT / F4 HALLUCINATED / F5 OFF-TOPIC) used throughout the LoCoMo benchmark pipeline; Fleiss kappa is computed inline without external stats libraries."
    },
