    {
      "id": "class:packages/agent/src/connectors/postgres-connector.ts:PostgresConnector",
      "type": "class",
      "name": "PostgresConnector",
      "filePath": "packages/agent/src/connectors/postgres-connector.ts",
      "lineRange": [28, 287],
      "summary": "Connector class for PostgreSQL that lazily loads the pg module, connects via connection string from Vault, and enforces SQL statement-type allowlists to prevent unauthorized DDL/DML operations.",
      "tags": ["connector", "database", "sql", "service"],
      "complexity": "complex",
      "languageNotes": "Uses dynamic import() of 'pg' at connect-time so it can be optional in non-DB environments; enforces a hardcoded allowlist of normalized SQL prefixes (SELECT/WITH/SHOW/SET vs INSERT/UPDATE/DELETE) to limit the blast radius of runQuery vs runExecute."
    },
