      "id": "file:app/src-tauri/src/service.rs",
      "type": "file",
      "name": "service.rs",
      "filePath": "app/src-tauri/src/service.rs",
      "summary": "Node.js sidecar lifecycle manager for the Tauri shell: resolves the Node binary path, builds the launch command with environment variables, spawns the process, exposes ensure/stop/port Tauri commands, and runs a watchdog loop that auto-restarts the sidecar on health-check failures.",
      "tags": ["service", "api-handler", "singleton"],
      "complexity": "complex",
      "languageNotes": "ServiceState holds the child process in a Mutex<Option<Child>> for thread-safe lifecycle control; build_service_command resolves bundled vs dev-mode Node paths and configures sqlite-vec and ONNX native library paths via environment variables."
    },
