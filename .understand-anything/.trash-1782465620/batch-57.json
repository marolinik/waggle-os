      "name": "kvark-auth.ts",
      "filePath": "packages/server/src/kvark/kvark-auth.ts",
      "summary": "Implements the KvarkAuth class that manages JWT/token-based authentication for the KVARK enterprise sovereign API, handling token acquisition, caching, invalidation, and timeout-protected login requests.",
      "tags": ["service", "authentication", "api-handler"],
      "complexity": "moderate"
    },
    {
      "id": "class:packages/server/src/kvark/kvark-auth.ts:KvarkAuth",
      "type": "class",
      "name": "KvarkAuth",
      "filePath": "packages/server/src/kvark/kvark-auth.ts",
      "lineRange": [20, 106],
      "summary": "Stateful authentication manager for KVARK that caches tokens, lazily refreshes them via login(), and exposes hasToken/tokenAgeMs for health inspection. Supports injectable fetch for testability.",
      "tags": ["authentication", "service", "api-handler"],
      "complexity": "moderate"
    },
    {
      "id": "file:packages/server/src/kvark/kvark-client.ts",
      "type": "file",
      "name": "kvark-client.ts",
      "filePath": "packages/server/src/kvark/kvark-client.ts",
      "summary": "Implements KvarkClient, the primary HTTP client for communicating with the KVARK enterprise API, providing search, askDocument, feedback, action, and ping operations with built-in retry/backoff logic and token-based auth.",
      "tags": ["service", "api-handler", "middleware"],
      "complexity": "complex",
      "languageNotes": "Uses exponential backoff with configurable retry-on-server-error and timeout-per-request via AbortController, layered over KvarkAuth for transparent token refresh."
    },
    {
      "id": "class:packages/server/src/kvark/kvark-client.ts:KvarkClient",
      "type": "class",
      "name": "KvarkClient",
      "filePath": "packages/server/src/kvark/kvark-client.ts",
      "lineRange": [35, 248],
      "summary": "Full-featured HTTP client for the KVARK API with 11 methods covering search, document Q&A, feedback, arbitrary actions, health ping, and internal request/retry plumbing. Delegates auth to KvarkAuth.",
      "tags": ["service", "api-handler", "middleware"],
      "complexity": "complex"
    },
    {
      "id": "file:packages/server/src/kvark/kvark-config.ts",
      "type": "file",
      "name": "kvark-config.ts",
      "filePath": "packages/server/src/kvark/kvark-config.ts",
      "summary": "Exports getKvarkConfig(), which reads KVARK connection credentials from the Waggle vault and returns a typed KvarkConfig object used to initialize KvarkClient and KvarkAuth.",
      "tags": ["config", "service", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:packages/server/src/kvark/kvark-config.ts:getKvarkConfig",
      "type": "function",
      "name": "getKvarkConfig",
      "filePath": "packages/server/src/kvark/kvark-config.ts",
      "lineRange": [18, 44],
      "summary": "Reads KVARK API URL, credentials, and optional settings from the vault store and assembles them into a KvarkConfig. Returns null/partial config gracefully when keys are absent.",
      "tags": ["config", "utility", "service"],
      "complexity": "simple"
    },
    {
      "id": "file:packages/server/src/kvark/kvark-types.ts",
      "type": "file",
      "name": "kvark-types.ts",
      "filePath": "packages/server/src/kvark/kvark-types.ts",
      "summary": "Defines all TypeScript interfaces, types, and error classes for the KVARK client subsystem, including KvarkConfig, request/response shapes, and a typed error hierarchy (Auth, NotFound, NotImplemented, Server, Unavailable).",
      "tags": ["type-definition", "service", "api-handler"],
      "complexity": "moderate",
      "languageNotes": "Error classes extend a base KvarkError which extends Error, providing a typed error hierarchy for structured catch blocks upstream."
    },
