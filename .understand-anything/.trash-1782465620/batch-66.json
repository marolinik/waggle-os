      "filePath": "packages/sdk/src/plugin-manifest.ts",
      "summary": "Defines the PluginManifest TypeScript interface and exports the validatePluginManifest function that validates all required manifest fields including name, version, skills, MCP servers, and tool definitions.",
      "tags": ["validation", "type-definition", "plugin", "sdk"],
      "complexity": "moderate"
    },
    {
      "id": "function:packages/sdk/src/plugin-manifest.ts:validatePluginManifest",
      "type": "function",
      "name": "validatePluginManifest",
      "filePath": "packages/sdk/src/plugin-manifest.ts",
      "lineRange": [24, 106],
      "summary": "Validates a plugin manifest object, checking required string fields, skills array, MCP server definitions (name, command, args), and tool definitions (name format, description), returning an errors array and validity flag.",
      "tags": ["validation", "plugin", "sdk"],
      "complexity": "moderate"
    },
    {
      "id": "file:packages/sdk/src/plugin-runtime.ts",
      "type": "file",
      "name": "plugin-runtime.ts",
      "filePath": "packages/sdk/src/plugin-runtime.ts",
      "summary": "Provides the plugin runtime layer — PluginRuntime implements an EventEmitter-based state machine (disabled/enabled/active/error) for individual plugins, PluginRuntimeManager aggregates all registered plugins and exposes collected tools and skills, and makePluginToolExecutor dynamically imports and executes plugin tool handlers.",
      "tags": ["service", "plugin", "event-handler", "sdk"],
      "complexity": "complex",
      "languageNotes": "PluginRuntime extends EventEmitter and implements a state machine with explicit transition guards; makePluginToolExecutor uses dynamic import() to load plugin handlers at runtime, supporting .js/.cjs/.mjs extension candidates."
    },
    {
      "id": "class:packages/sdk/src/plugin-runtime.ts:PluginRuntime",
      "type": "class",
      "name": "PluginRuntime",
      "filePath": "packages/sdk/src/plugin-runtime.ts",
      "lineRange": [62, 167],
      "summary": "Represents a single plugin's runtime state machine (disabled → enabled → active / error), emitting state-change events and lazily activating tool executors and contributed skills when enabled.",
      "tags": ["service", "event-handler", "plugin", "sdk"],
      "complexity": "complex"
    },
    {
      "id": "class:packages/sdk/src/plugin-runtime.ts:PluginRuntimeManager",
      "type": "class",
      "name": "PluginRuntimeManager",
      "filePath": "packages/sdk/src/plugin-runtime.ts",
      "lineRange": [210, 287],
      "summary": "Aggregates multiple PluginRuntime instances, providing unified APIs for enabling/disabling plugins, retrieving all contributed tools and skills from active plugins, and forwarding state-change events.",
      "tags": ["service", "plugin", "factory", "sdk"],
      "complexity": "moderate"
    },
    {
      "id": "function:packages/sdk/src/plugin-runtime.ts:makePluginToolExecutor",
      "type": "function",
      "name": "makePluginToolExecutor",
      "filePath": "packages/sdk/src/plugin-runtime.ts",
      "lineRange": [177, 204],
      "summary": "Creates an executor function for a plugin tool definition by resolving the handler module path (trying .js/.cjs/.mjs candidates), dynamically importing it, and invoking its execute export with JSON-serialized arguments.",
      "tags": ["factory", "plugin", "sdk", "utility"],
      "complexity": "moderate"
    },
