      "summary": "Manages plugin lifecycle on disk — install from local directory, uninstall, list registered plugins, and convert the registry into a PluginRuntimeManager for active use.",
      "tags": ["service", "plugin", "registry", "sdk"],
      "complexity": "moderate"
    },
    {
      "id": "file:packages/sdk/src/plugin-manifest.ts",
      "type": "file",
